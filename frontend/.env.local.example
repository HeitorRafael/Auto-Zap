# Copie para .env.local e preencha antes de rodar localmente
# Configure também na Vercel em Project Settings > Environment Variables

# Typebot — IDs dos flows publicados (pegar no Typebot Builder após publicar)
NEXT_PUBLIC_TYPEBOT_IMOBILIARIA_ID=
NEXT_PUBLIC_TYPEBOT_RESTAURANTE_ID=
NEXT_PUBLIC_TYPEBOT_ESTETICA_ID=
NEXT_PUBLIC_TYPEBOT_VIEWER_URL=https://bot.autoatende.com.br

# WhatsApp de contato da AutoAtende (formato: 5513XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_CONTATO=5513999999999

# n8n — Webhook para receber leads do formulário de contato
N8N_WEBHOOK_URL=https://n8n.autoatende.com.br/webhook/contato

# Painel Admin — gere o hash com:
# node -e "require('bcryptjs').hash('suasenha',10).then(console.log)"
ADMIN_PASSWORD_HASH=

# Segredo JWT para sessão do admin (mesma var usada pelo Typebot)
# NEXTAUTH_SECRET já foi definida no infra/.env — usar o mesmo valor

# Google Sheets — para o painel admin ler os leads
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_API_KEY=

# Segredo para validar webhooks do n8n na rota /api/leads
WEBHOOK_SECRET=
