# =============================================================================
# AutoAtende — Variáveis de Ambiente
# Copie este arquivo para .env e preencha TODOS os valores antes de subir
# NUNCA commite o arquivo .env — ele está no .gitignore
# =============================================================================

# ─── DOMÍNIO ────────────────────────────────────────────────────────────────
# Domínio base. Os subdomínios serão: api., flows., bot., n8n., atende.
DOMAIN=autoatende.com.br

# ─── VPS ────────────────────────────────────────────────────────────────────
VPS_IP=                          # IP público do servidor (ex: 123.45.67.89)

# ─── BANCO DE DADOS ─────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=

# Nomes dos databases (não alterar — usados no init-db.sh)
POSTGRES_DB_TYPEBOT=typebot
POSTGRES_DB_CHATWOOT=chatwoot
POSTGRES_DB_N8N=n8n
POSTGRES_DB_EVOLUTION=evolution

# ─── REDIS ──────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 24
REDIS_PASSWORD=

# ─── EVOLUTION API ──────────────────────────────────────────────────────────
# Chave de autenticação da API — gere com: openssl rand -hex 32
EVOLUTION_API_KEY=

# ─── TYPEBOT ────────────────────────────────────────────────────────────────
# Gere ambos com: openssl rand -base64 32
TYPEBOT_ENCRYPTION_SECRET=
NEXTAUTH_SECRET=

# ─── N8N ────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=        # Senha forte — mínimo 16 caracteres
# Gere com: openssl rand -base64 32
N8N_ENCRYPTION_KEY=

# ─── CHATWOOT ───────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=

# ─── SMTP (para Typebot e Chatwoot enviarem emails) ─────────────────────────
# Recomendado: Brevo (antigo Sendinblue) — plano gratuito suficiente
SMTP_HOST=smtp.gmail.com         # ou smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=                       # seu email
SMTP_PASSWORD=                   # senha de app (não a senha da conta)

# ─── OPENAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=                  # sk-...

# ─── GOOGLE APIS ────────────────────────────────────────────────────────────
GOOGLE_SHEETS_API_KEY=
# JSON da service account em uma única linha (escape as aspas)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# ─── FRONTEND (Next.js — preencher na Vercel também) ────────────────────────
NEXT_PUBLIC_TYPEBOT_IMOBILIARIA_ID=   # ID do fluxo publicado no Typebot
NEXT_PUBLIC_TYPEBOT_RESTAURANTE_ID=
NEXT_PUBLIC_TYPEBOT_ESTETICA_ID=
NEXT_PUBLIC_WHATSAPP_CONTATO=         # 5513XXXXXXXXX (sem + e sem espaços)
# Gere com: node -e "const b=require('bcryptjs');b.hash('suasenha',10).then(console.log)"
ADMIN_PASSWORD_HASH=

# =============================================================================
# COMO GERAR AS SENHAS FORTES (rode no terminal do VPS):
#
#   openssl rand -base64 32   → para a maioria das chaves
#   openssl rand -hex 64      → para CHATWOOT_SECRET_KEY_BASE
#   openssl rand -hex 32      → para EVOLUTION_API_KEY e N8N_ENCRYPTION_KEY
#
# =============================================================================
