{
  "name": "AutoAtende — Captura de Lead → Google Sheets",
  "nodes": [
    {
      "id": "node-webhook-trigger",
      "name": "Webhook — Recebe Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "imobiliaria-lead",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "node-validar",
      "name": "Validar Dados Obrigatórios",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [500, 300],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.nome }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.body.telefone }}",
              "operation": "isNotEmpty"
            }
          ]
        },
        "combineOperation": "all"
      }
    },
    {
      "id": "node-formatar-tel",
      "name": "Formatar Telefone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [750, 200],
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\n// Remove tudo que não é dígito\nlet tel = body.telefone.replace(/\\D/g, '');\n\n// Garante que começa com 55 (Brasil)\nif (!tel.startsWith('55')) {\n  tel = '55' + tel;\n}\n\n// Garante 9º dígito em celulares\nif (tel.length === 12 && tel[4] !== '9') {\n  tel = tel.slice(0,4) + '9' + tel.slice(4);\n}\n\nreturn [{\n  json: {\n    nome:        body.nome,\n    telefone:    tel,\n    intencao:    body.intencao  || '',\n    localizacao: body.localizacao || '',\n    dormitorios: body.dormitorios || '',\n    orcamento:   body.orcamento  || '',\n    timestamp:   new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }),\n    status:      'Novo'\n  }\n}];"
      }
    },
    {
      "id": "node-sheets",
      "name": "Google Sheets — Registrar Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1000, 200],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $vars.SHEETS_ID_CLIENTE }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Data/Hora":    "={{ $json.timestamp }}",
            "Nome":         "={{ $json.nome }}",
            "Telefone":     "={{ $json.telefone }}",
            "Intenção":     "={{ $json.intencao }}",
            "Localização":  "={{ $json.localizacao }}",
            "Dormitórios":  "={{ $json.dormitorios }}",
            "Orçamento":    "={{ $json.orcamento }}",
            "Status":       "={{ $json.status }}"
          }
        }
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "cred-sheets", "name": "Google Sheets" } }
    },
    {
      "id": "node-notif-wa",
      "name": "Notificar Dono — WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1250, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.EVOLUTION_URL }}/message/sendText/{{ $vars.INSTANCE_NAME }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "apikey", "value": "={{ $vars.EVOLUTION_API_KEY }}" }]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"number\": \"{{ $vars.TELEFONE_DONO }}\",\n  \"text\": \"🏠 Novo lead!\\n\\n*Nome:* {{ $json.nome }}\\n*Intenção:* {{ $json.intencao }}\\n*Localização:* {{ $json.localizacao }}\\n*Orçamento:* {{ $json.orcamento }}\\n*Telefone:* {{ $json.telefone }}\\n\\nAcesse a planilha para mais detalhes.\"\n}"
      }
    },
    {
      "id": "node-resposta-ok",
      "name": "Resposta 200 — Typebot",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1500, 200],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\", \"message\": \"Lead registrado com sucesso\" }",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "node-dados-invalidos",
      "name": "Dados Inválidos — Log",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [750, 450],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"error\", \"message\": \"nome e telefone são obrigatórios\" }",
        "options": { "responseCode": 400 }
      }
    }
  ],
  "connections": {
    "Webhook — Recebe Lead": {
      "main": [[{ "node": "Validar Dados Obrigatórios", "type": "main", "index": 0 }]]
    },
    "Validar Dados Obrigatórios": {
      "main": [
        [{ "node": "Formatar Telefone", "type": "main", "index": 0 }],
        [{ "node": "Dados Inválidos — Log", "type": "main", "index": 0 }]
      ]
    },
    "Formatar Telefone": {
      "main": [[{ "node": "Google Sheets — Registrar Lead", "type": "main", "index": 0 }]]
    },
    "Google Sheets — Registrar Lead": {
      "main": [[{ "node": "Notificar Dono — WhatsApp", "type": "main", "index": 0 }]]
    },
    "Notificar Dono — WhatsApp": {
      "main": [[{ "node": "Resposta 200 — Typebot", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": [{ "name": "autoatende" }, { "name": "lead-capture" }],
  "meta": { "instanceId": "autoatende" }
}
